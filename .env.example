# Discord Bot Configuration
DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_client_id_here
GUILD_ID=your_guild_id_here

# Ticket System Configuration
# ID ของยศทีมงานที่ให้ดูแลและเข้าห้อง Ticket ได้ (Role ID)
STAFF_ROLE_ID=your_staff_role_id_here

# ID ของหมวดหมู่ (Category) ที่จะให้สร้างห้อง Ticket เอาไว้
TICKET_CATEGORY_ID=your_ticket_category_id_here

# ID ของห้องสำหรับส่ง Log / Transcript เมื่อ Ticket ถูกปิด (ไม่ใส่ก็ได้)
TRANSCRIPT_CHANNEL_ID=your_transcript_channel_id_here

# ID ของห้องสำหรับส่งรีวิวให้คะแนน 1-5 ดาวจากลูกค้า (ไม่ใส่ก็ได้)
REVIEWS_CHANNEL_ID=your_reviews_channel_id_here

# Web Server Port สำหรับ Web Hosting
PORT=3000
